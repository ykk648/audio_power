FUNASR_MAX_UPLOAD_MB=500

# pyannote local diarization
PYANNOTE_MODEL_PATH=pretrain_models/audio_dirazation/pyannote/community-1
PYANNOTE_DEVICE=auto
PYANNOTE_PRELOAD=true
PYANNOTE_TRUST_MODEL_PICKLE=true
PYANNOTE_MAX_CONCURRENCY=1
PYANNOTE_MAX_UPLOAD_MB=500

